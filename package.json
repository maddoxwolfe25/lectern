{
  "name": "lectern",
  "productName": "Lectern",
  "version": "1.3.0",
  "description": "A PDF reader that reads aloud. The page follows the voice.",
  "author": "Maddox Wolfe",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "npx -y http-server -p 8124 -c-1 .",
    "dist": "electron-builder --win --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "predist": "node scripts/fetch-piper.js && node scripts/fetch-ocr.js && node scripts/build-workers.js"
  },
  "devDependencies": {
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@pdfme/pdf-lib": "^6.2.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1"
  },
  "build": {
    "appId": "com.maddoxwolfe.lectern",
    "productName": "Lectern",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "edit.css",
      "app.js",
      "edit.js",
      "pro.css",
      "pro.js",
      "tabs-preload.js",
      "tabs.js",
      "tabs.css",
      "tabs.html",
      "sample.pdf",
      "icon.png",
      "icon.ico",
      "vendor/**/*",
      "!vendor/piper/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico",
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF Document",
          "description": "PDF Document",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Lectern",
      "artifactName": "Lectern-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Lectern-${version}-portable.exe"
    },
    "extraResources": [
      {
        "from": "vendor/piper",
        "to": "piper",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "maddoxwolfe25",
        "repo": "lectern",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": "github:maddoxwolfe25/lectern",
  "homepage": "https://github.com/maddoxwolfe25/lectern"
}
